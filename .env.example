# Database: either a full URL...
NUXT_DATABASE_URL=mysql://mesh:mesh@localhost:3308/meshtastic
# ...or Forge/Laravel-style variables (used when NUXT_DATABASE_URL is not set)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=forge
# DB_USERNAME=forge
# DB_PASSWORD=
MYSQL_PASSWORD=mesh

# MQTT broker
NUXT_MQTT_URL=mqtt://mqtt.meshtastic.pt:1883
NUXT_MQTT_USERNAME=meshdev
NUXT_MQTT_PASSWORD=large4cats
NUXT_MQTT_TOPIC="msh/#"

# Comma-separated base64 channel keys, tried in order (AQ== = default LongFast key)
NUXT_CHANNEL_KEYS=AQ==

# Comma-separated node IDs to monitor. Leave empty to store every node on the broker.
NUXT_NODE_IDS=

# Days to keep the raw packet log. 0 = keep forever (telemetry, positions and links are always kept)
NUXT_RETENTION_DAYS=0
